{
  "version": 1,
  "respectGitignore": true,
  "checks": [
    {
      "id": "lint",
      "purpose": "lint",
      "required": true,
      "command": "node",
      "args": [
        "node_modules/eslint/bin/eslint.js",
        ".",
        "--format",
        "json"
      ],
      "format": "eslint-json"
    },
    {
      "id": "types-app",
      "purpose": "typecheck",
      "required": true,
      "command": "node",
      "args": [
        "node_modules/typescript/bin/tsc",
        "--project",
        "tsconfig.app.json",
        "--noEmit",
        "--pretty",
        "false"
      ],
      "failureExitCodes": [
        1,
        2
      ]
    },
    {
      "id": "types-node",
      "purpose": "typecheck",
      "required": true,
      "command": "node",
      "args": [
        "node_modules/typescript/bin/tsc",
        "--project",
        "tsconfig.node.json",
        "--noEmit",
        "--pretty",
        "false"
      ],
      "failureExitCodes": [
        1,
        2
      ]
    },
    {
      "id": "behavior",
      "purpose": "test",
      "required": true,
      "command": "node",
      "args": [
        "node_modules/vitest/vitest.mjs",
        "run"
      ],
      "timeoutMs": 60000,
      "failureExitCodes": [
        1
      ]
    }
  ]
}
