{
  "version": 1,
  "respectGitignore": true,
  "checks": [
    {
      "id": "lint",
      "purpose": "lint",
      "required": true,
      "command": "node",
      "args": [
        "node_modules/eslint/bin/eslint.js",
        ".",
        "--format",
        "json"
      ],
      "format": "eslint-json"
    },
    {
      "id": "types-app",
      "purpose": "typecheck",
      "required": true,
      "command": "node",
      "args": [
        "node_modules/typescript/bin/tsc",
        "--project",
        "tsconfig.app.json",
        "--noEmit",
        "--pretty",
        "false"
      ],
      "failureExitCodes": [
        1,
        2
      ]
    },
    {
      "id": "types-node",
      "purpose": "typecheck",
      "required": true,
      "command": "node",
      "args": [
        "node_modules/typescript/bin/tsc",
        "--project",
        "tsconfig.node.json",
        "--noEmit",
        "--pretty",
        "false"
      ],
      "failureExitCodes": [
        1,
        2
      ]
    },
    {
      "id": "behavior",
      "purpose": "test",
      "required": true,
      "command": "node",
      "args": [
        "node_modules/vitest/vitest.mjs",
        "run"
      ],
      "timeoutMs": 60000,
      "failureExitCodes": [
        1
      ]
    }
  ],
  "exclude": [
    "audit-reports/**"
  ],
  "ai": {
    "apiKeyEnv": "SHIPCHECK_API_KEY",
    "mode": "low-cost",
    "maxOutputTokens": 2000,
    "timeoutMs": 60000
  },
  "currentTask": {
    "id": "poison-floor",
    "title": "Prevent negative poison counters",
    "files": [
      "src/LifeTracker.tsx",
      "src/poison.ts"
    ],
    "requirements": [
      {
        "id": "floor",
        "text": "Poison starts at zero. Decrementing poison at zero leaves it at zero, including repeated decrements."
      },
      {
        "id": "updates",
        "text": "Increment adds one; decrement subtracts one from positive poison and stops at zero."
      },
      {
        "id": "isolation",
        "text": "Only the selected player's poison changes. Other players and life totals remain unchanged. Life controls retain their existing behavior, including negative totals."
      }
    ],
    "nonGoals": [
      "No persistence, reset, player-management, or unrelated life-handler changes."
    ]
  }
}
